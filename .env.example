# Copy to .env before running `make up`.

# Postgres — never installed on the host, only via Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=nirantharseva
DATABASE_URL=postgresql+asyncpg://postgres:dev@db:5432/nirantharseva

# Auth
JWT_SECRET=dev-secret-change-for-anything-real
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Clock — see docs/decisions/ADR-001.md. real|simulated
CLOCK_MODE=real
SIM_START=2026-01-01T00:00:00Z

# Instrumentation — see IMPLEMENTATION_PLAN.md §12
RUN_ID=
LOG_LEVEL=INFO

# Escalation sweep — see docs/PHASE5_PLAN.md D17. Demo config: SLA_SCALE
# small enough (e.g. 0.001) to breach in seconds, SWEEP_INTERVAL_SECONDS=10.
SLA_SCALE=1.0
SWEEP_INTERVAL_SECONDS=300

# Identity resolution — see docs/PHASE6_PLAN.md P6.1, docs/decisions/ADR-014.md.
# Scores are 0-100 (rapidfuzz scale). E3 sweeps both.
IDENTITY_AUTO_ACCEPT=92.0
IDENTITY_REVIEW_FLOOR=80.0
