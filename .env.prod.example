# Copy to .env.prod, fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Every var below with no value shown is required — docker-compose.prod.yml
# uses ${VAR:?message} for each one, so `up` refuses to start rather than
# silently falling back to a development value (P9.2, ADR-018).

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres:<same-password-as-above>@db:5432/nirantharseva
JWT_SECRET=
CORS_ORIGINS=

# Optional — sane production defaults if omitted, see docker-compose.prod.yml.
POSTGRES_USER=postgres
POSTGRES_DB=nirantharseva
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
LOG_LEVEL=INFO
SLA_SCALE=1.0
SWEEP_INTERVAL_SECONDS=300
IDENTITY_AUTO_ACCEPT=92.0
IDENTITY_REVIEW_FLOOR=80.0
RUN_ID=
