# P9.2 (D43, ADR-018) — the client served as a built, static bundle, not
# the Vite dev server. Two stages: build the real production bundle
# (npm run build, the same command README.md's "Test it" section already
# uses), then serve only the output (dist/) from nginx. No source, no
# node_modules, and no Vite process exist in the final image at all.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
